# AquaTwin SCADA Frontend Environment Variables

# Production API Endpoint (Render backend domain)
# VITE_API_URL=https://aquatwin-backend.onrender.com

# Local Development API Endpoint
VITE_API_URL=http://localhost:8000

# WebSocket Endpoint (Optional - automatically resolved to wss:// if VITE_API_URL uses https://)
# VITE_WS_URL=wss://aquatwin-backend.onrender.com/ws/telemetry
