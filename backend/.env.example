# AquaTwin SCADA Backend Environment Variables

# Server Binding (Render automatically injects PORT)
PORT=8000
HOST=0.0.0.0

# Database URL
# For local SQLite development (leave blank or use sqlite path):
DATABASE_URL=
# For Render PostgreSQL production deployment, use:
# DATABASE_URL=postgresql://user:password@hostname.render.com/aquatwin_db

# JWT Authentication Secret Key
SECRET_KEY=aquatwin_secret_scada_key_2026_super_secure

# Allowed CORS Origins (comma separated list of frontend domains)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://aquatwin.vercel.app
